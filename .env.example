# Copy to .env at repository root; replace placeholders locally.
# Django reads this file without overriding existing process environment variables.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL only. Never use production credentials for development/tests.
PGDATABASE=growthsathi_class_dev
PGUSER=growthsathi_app_dev
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
PGSSLMODE=prefer
PGTESTDATABASE=growthsathi_class_test
# The optional database integration test creates/drops PGTESTDATABASE.
# Use a dedicated local/CI role with CREATEDB, never a production role.
RUN_DATABASE_TESTS=false

# Frontend defaults to a local Django proxy; see docs/OPERATIONS.md.

# Separate operator hostnames; never use an institute hostname here.
PLATFORM_HOSTS=
