# Copy to .env at repository root; replace placeholders locally.
# Django reads this file without overriding existing process environment variables.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,platform.localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://platform.localhost:3000
# Required whenever the frontend proxy must preserve the public tenant host.
# Generate a strong value locally and set the identical value in frontend/.env.local.
PROXY_TENANT_SECRET=

# PostgreSQL only. Never use production credentials for development/tests.
PGDATABASE=growthsathi_class_dev
PGUSER=growthsathi_app_dev
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
PGSSLMODE=prefer
PGTESTDATABASE=growthsathi_class_test
# The optional database integration test creates/drops PGTESTDATABASE.
# Use a dedicated local/CI role with CREATEDB, never a production role.
RUN_DATABASE_TESTS=false

# Frontend defaults to a local Django proxy; see docs/OPERATIONS.md.

# Separate operator hostnames; never use an institute hostname here.
PLATFORM_HOSTS=platform.localhost

# Optional private Cloudflare R2 storage. Configure all four values together.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=growthsathi-private-media
R2_ENDPOINT_URL=https://dash.cloudflare.com/9b0f9ec0b3f617fa177a49bbb335fab4/r2/overview
R2_REGION=auto

# Email delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GrowthSathi
